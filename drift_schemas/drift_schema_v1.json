    {
      "name": "meta_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meta_entries\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sex\" TEXT NOT NULL, \"age_years\" INTEGER NOT NULL, \"height_cm\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, \"death_mode\" TEXT NOT NULL, \"rng_seed\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, \"died_at\" TEXT NULL, \"death_cause\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "vitals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vitals\" (\"profile_id\" INTEGER NOT NULL, \"last_update\" TEXT NOT NULL, \"blood_ml\" REAL NOT NULL, \"water_ml\" REAL NOT NULL, \"calories_kcal\" REAL NOT NULL, \"heart_rate_bpm\" REAL NOT NULL, \"sleep_debt_seconds\" INTEGER NOT NULL DEFAULT 0, \"zone\" TEXT NOT NULL DEFAULT 'open', \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"accuracy_m\" REAL NULL, \"rng_cursors\" TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (\"profile_id\"), FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "chronicle_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chronicle_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL, \"survival_days\" INTEGER NOT NULL, \"started_at\" TEXT NOT NULL, \"ended_at\" TEXT NOT NULL, \"cause\" TEXT NOT NULL, \"death_mode\" TEXT NOT NULL, \"snapshot_json\" TEXT NOT NULL DEFAULT '{}', FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "snapshot_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"snapshot_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"file_name\" TEXT NOT NULL, \"taken_at\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"checksum\" TEXT NOT NULL, \"schema_version\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL DEFAULT 'periodic');"
        }
      ]
    }
