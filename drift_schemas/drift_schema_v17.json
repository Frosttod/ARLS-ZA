          "sql": "CREATE TABLE IF NOT EXISTS \"shelters\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"started_at\" TEXT NOT NULL, \"build_seconds\" INTEGER NOT NULL, \"build_left_seconds\" INTEGER NULL, \"worked_at\" TEXT NULL, \"modules\" TEXT NOT NULL DEFAULT '', \"visited_at\" TEXT NULL, \"building\" TEXT NULL, \"building_ready_at\" TEXT NULL, \"building_left_seconds\" INTEGER NULL, FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE);"
