      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meta_entries\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sex\" TEXT NOT NULL, \"age_years\" INTEGER NOT NULL, \"height_cm\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, \"measured_resting_hr\" INTEGER NULL, \"death_mode\" TEXT NOT NULL, \"rng_seed\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, \"died_at\" TEXT NULL, \"death_cause\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "vitals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vitals\" (\"profile_id\" INTEGER NOT NULL, \"last_update\" TEXT NOT NULL, \"blood_ml\" REAL NOT NULL, \"water_ml\" REAL NOT NULL, \"calories_kcal\" REAL NOT NULL, \"heart_rate_bpm\" REAL NOT NULL, \"sleep_debt_seconds\" INTEGER NOT NULL DEFAULT 0, \"zone\" TEXT NOT NULL DEFAULT 'open', \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"accuracy_m\" REAL NULL, \"rng_cursors\" TEXT NOT NULL DEFAULT '{}', \"bleed_tier\" TEXT NOT NULL DEFAULT 'none', \"down_until\" TEXT NULL, \"hunt_until\" TEXT NULL, \"hunt_latitude\" REAL NULL, \"hunt_longitude\" REAL NULL, \"hunt_count\" INTEGER NOT NULL DEFAULT 0, \"occupation_json\" TEXT NULL, \"speed_kmh\" REAL NOT NULL DEFAULT 0.0, \"carried_kg\" REAL NOT NULL DEFAULT 0.0, \"pending_kcal\" REAL NOT NULL DEFAULT 0.0, \"pending_water_ml\" REAL NOT NULL DEFAULT 0.0, PRIMARY KEY (\"profile_id\"), FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "chronicle_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chronicle_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL, \"survival_days\" INTEGER NOT NULL, \"started_at\" TEXT NOT NULL, \"ended_at\" TEXT NOT NULL, \"cause\" TEXT NOT NULL, \"death_mode\" TEXT NOT NULL, \"snapshot_json\" TEXT NOT NULL DEFAULT '{}', FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "snapshot_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"snapshot_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"file_name\" TEXT NOT NULL, \"taken_at\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"checksum\" TEXT NOT NULL, \"schema_version\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL DEFAULT 'periodic');"
        }
      ]
    },
    {
      "name": "inventory_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory_lines\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL, \"item_id\" TEXT NOT NULL, \"count\" INTEGER NOT NULL DEFAULT 1, \"slot\" TEXT NOT NULL DEFAULT 'pack', \"condition\" REAL NULL, \"pages_total\" INTEGER NULL, \"pages_read\" INTEGER NOT NULL DEFAULT 0, \"note_id\" TEXT NULL, \"portion\" REAL NOT NULL DEFAULT 1.0, \"attachments\" TEXT NOT NULL DEFAULT '', FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "loot_boxes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"loot_boxes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL, \"poi_id\" TEXT NOT NULL, \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"table_id\" TEXT NOT NULL, \"name\" TEXT NULL, \"spawned_at\" TEXT NOT NULL, \"looted_at\" TEXT NULL, \"respawn_at\" TEXT NULL, \"opened_at\" TEXT NULL, \"search_units\" INTEGER NOT NULL DEFAULT 0, FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE, UNIQUE (profile_id, poi_id));"
        }
      ]
    },
    {
      "name": "ground_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ground_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL, \"item_id\" TEXT NOT NULL, \"count\" INTEGER NOT NULL DEFAULT 1, \"condition\" REAL NULL, \"pages_total\" INTEGER NULL, \"pages_read\" INTEGER NOT NULL DEFAULT 0, \"attachments\" TEXT NOT NULL DEFAULT '', \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"dropped_at\" TEXT NOT NULL, FOREIGN KEY (profile_id) REFERENCES profiles (id) ON DELETE CASCADE);"
        }
